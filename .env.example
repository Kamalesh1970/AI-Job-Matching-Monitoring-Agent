ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
ADZUNA_RESULTS_PER_PAGE=20
ADZUNA_MAX_PAGES=2

INTERNSHALA_ENABLED=true
INTERNSHALA_INTERVAL_HOURS=12
INTERNSHALA_REQUEST_DELAY_MIN=2
INTERNSHALA_REQUEST_DELAY_MAX=5
INTERNSHALA_MAX_PAGES=3

RESUME_PATH=data/resume/base_resume.txt
EMBEDDING_MODEL=all-MiniLM-L6-v2
SEMANTIC_WEIGHT=0.50
SKILL_WEIGHT=0.30
RULE_WEIGHT=0.20
MIN_MATCH_SCORE=60
PREFERRED_LOCATIONS=Coimbatore,Chennai,Bangalore,Bengaluru,Hyderabad,Pune,Remote,India

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_MATCH_SCORE=70
TELEGRAM_MAX_JOBS_PER_DIGEST=10
TELEGRAM_ENABLED=true
SEND_EMPTY_DIGEST=false

SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=60
HEARTBEAT_TIMEOUT_MINUTES=180
RUN_ON_STARTUP=true

# Source Enablement Flags
SOURCE_ADZUNA_ENABLED=true
SOURCE_INTERNSHALA_ENABLED=true
SOURCE_GMAIL_ENABLED=false
SOURCE_LINKEDIN_ENABLED=true
SOURCE_INDEED_ENABLED=true
SOURCE_ARBEITNOW_ENABLED=true
SOURCE_REMOTEOK_ENABLED=true
SOURCE_JOBICY_ENABLED=true
SOURCE_HIMALAYAS_ENABLED=true
SOURCE_JOOBLE_ENABLED=true
SOURCE_JSEARCH_ENABLED=true
SOURCE_SERPAPI_ENABLED=true
SOURCE_ACTIVE_JOBS_DB_ENABLED=false
SOURCE_LINKEDIN_JOBS_API_ENABLED=false
SOURCE_INDEED_JOBS_API_ENABLED=false
SOURCE_NAUKRI_ENABLED=true
SOURCE_GLASSDOOR_ENABLED=true
SOURCE_UNSTOP_ENABLED=true
SOURCE_FOUNDIT_ENABLED=true
SOURCE_CUTSHORT_ENABLED=true
SOURCE_HIRIST_ENABLED=true
