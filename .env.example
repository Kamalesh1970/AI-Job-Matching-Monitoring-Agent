CANDIDATE_YEARS_EXPERIENCE=0
CANDIDATE_STATUS=FINAL_YEAR_STUDENT
MATCH_THRESHOLD_STRONG=75.0
MATCH_THRESHOLD_POTENTIAL=50.0
MATCH_THRESHOLD_LOW=30.0

# Gmail Search Queries
GMAIL_LINKEDIN_QUERY=from:(linkedin.com) newer_than:2d
GMAIL_INDEED_QUERY=from:(indeed.com) newer_than:2d
GMAIL_NAUKRI_QUERY=from:(naukri.com) newer_than:2d
GMAIL_GLASSDOOR_QUERY=from:(glassdoor.com) newer_than:2d
